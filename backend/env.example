# MongoDB Connection String (GridFS enabled)
MONGO_URI=mongodb://localhost:27017/secure-file-sharing

# API Server Port
PORT=4000

# JSON Web Token Secret & Expiration
JWT_SECRET=replace-with-a-secure-random-32-character-secret
JWT_EXPIRES_IN=24h

# 256-bit AES Master Secret for Key-Wrap
KEY_WRAP_SECRET=replace-with-a-secure-256-bit-master-key

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
